<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@color/bg">

    <ImageView android:layout_width="88dp" android:layout_height="88dp"
        android:src="@drawable/ic_bolt"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="X Game Booster"
        android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="ایکس گیم بوستر — نسخه ۴.۱.۰"
        android:textColor="@color/text2" android:textSize="13sp"/>

    <ProgressBar android:layout_width="28dp" android:layout_height="28dp"
        android:layout_marginTop="28dp"/>
</LinearLayout>
