<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="8dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_bolt"/>
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="X Game Booster" android:textColor="@color/text"
            android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvUser" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text2" android:textSize="12sp" android:layout_marginEnd="4dp"/>
        <ImageButton android:id="@+id/btnSettings" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_settings" android:background="?android:attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="24dp">

            <LinearLayout style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_ram"/>
                    <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="بوستر رم و بازی"/>
                    <TextView android:id="@+id/tvRamPct" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0%" android:textColor="@color/accent" android:textSize="15sp" android:textStyle="bold"/>
                </LinearLayout>
                <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:id="@+id/barRam"
                    android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="12dp"
                    android:max="100" android:progress="0" android:progressDrawable="@drawable/progress_ram"/>
                <TextView android:id="@+id/tvRamDetail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/text2" android:textSize="12sp"/>
                <Button android:id="@+id/btnBoost" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="14dp" android:background="@drawable/bg_accent"
                    android:text="بوست سریع رم" android:textColor="@color/btnText"
                    android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_wifi"/>
                    <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="بوستر پینگ (تونل DNS)"/>
                    <Switch android:id="@+id/swVpn" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:id="@+id/tvVpnState" style="@style/CardDesc"
                    android:text="تونل غیرفعال است"/>
                <TextView android:id="@+id/tvPing" style="@style/CardDesc" android:textColor="@color/accent2"/>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_ghost"/>
                    <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="حالت شبح (Ghost)"/>
                    <Switch android:id="@+id/swGhost" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView style="@style/CardDesc"
                    android:text="آیکون اپ مخفی می‌شود؛ بازگشت از طریق نوتیفیکیشن"/>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_cross"/>
                    <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="کراس‌هیر و HUD بازی"/>
                    <Switch android:id="@+id/swHud" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <Button android:id="@+id/btnCross" android:layout_width="match_parent" android:layout_height="42dp"
                    android:layout_marginTop="12dp" android:background="@drawable/bg_card"
                    android:text="تنظیمات کراس‌هیر" android:textColor="@color/accent" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_camera"/>
                    <TextView style="@style/CardTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_marginStart="8dp" android:text="ضبط صفحه"/>
                    <Button android:id="@+id/btnRecord" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:background="@drawable/bg_card" android:text="شروع ضبط"
                        android:textColor="@color/accent" android:textSize="13sp"/>
                </LinearLayout>
                <TextView style="@style/CardDesc"
                    android:text="خروجی در Movies/XGameBooster ذخیره می‌شود"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardPremium" style="@style/Card"
                android:background="@drawable/bg_gold">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_crown"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="ارتقا به نسخه پریمیوم"
                        android:textColor="@color/btnText" android:textSize="15sp" android:textStyle="bold"/>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_play"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:layout_marginStart="16dp"
                android:text="بازی‌ها و اپ‌های تو — لمس کن تا بوست و اجرا شود"
                android:textColor="@color/text2" android:textSize="12sp"/>

            <ListView android:id="@+id/lvApps" android:layout_width="match_parent" android:layout_height="200dp"
                android:layout_marginTop="4dp" android:divider="@android:color/transparent"
                android:dividerHeight="0dp" android:paddingStart="6dp" android:paddingEnd="6dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
